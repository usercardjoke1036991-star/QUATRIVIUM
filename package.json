{
  "name": "quatrivium-sovereign",
  "license": "0BSD",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "test": "hardhat --config hardhat.config.cjs test",
    "test:forge": "wsl -d Ubuntu-24.04 -u root -- bash -lc \"export PATH=/root/.foundry/bin:\\$PATH && forge test --fuzz-runs 256\"",
    "test:coverage": "hardhat --config hardhat.config.cjs coverage",
    "typecheck": "node scripts/check-i18n.mjs && node scripts/check-external-services.mjs && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "compile": "hardhat --config hardhat.config.cjs compile",
    "security:check": "node scripts/security-check.mjs",
    "security:slither": "node scripts/run-slither.mjs",
    "security:mobsf": "node scripts/scan-mobile.mjs",
    "security:mobsf:purge": "node scripts/scan-mobile.mjs --purge",
    "security:trivy": "wsl -d Ubuntu-24.04 -u root -- bash scripts/trivy-lock.sh",
    "security:snyk": "node scripts/run-snyk.mjs test --severity-threshold=high --policy-path=.snyk",
    "security:snyk:code": "node scripts/run-snyk.mjs code test --severity-threshold=high",
    "security:sonar": "node scripts/run-sonar.mjs",
    "deploy:arbitrum": "hardhat --config hardhat.config.cjs run scripts/deploy-arbitrum-sovereign.cjs --network arbitrumOne",
    "deploy:arbitrum:sepolia": "hardhat --config hardhat.config.cjs run scripts/deploy-arbitrum-sovereign.cjs --network arbitrumSepolia",
    "deploy:testnet": "hardhat run scripts/deploy.cjs --network arbitrumSepolia",
    "deploy:testnet:nuevo": "hardhat --config hardhat.config.cjs run scripts/deploy-testnet-nuevo.cjs --network arbitrumSepolia",
    "deploy:reserva": "hardhat run scripts/deploy-reserva.cjs --network arbitrumSepolia",
    "production:check": "node scripts/check-production.mjs",
    "production:check:ci": "node scripts/check-production.mjs --ci",
    "production:prepare": "node scripts/prepare-production-local.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
