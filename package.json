    "react-native-paper": "^5.15.2",
    "react-native-qrcode-svg": "^6.3.24",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "readable-stream": "^4.7.0",
    "stream": "^0.0.3",
    "text-encoding": "^0.7.0",
    "wagmi": "^3.7.6",
    "zustand": "^5.0.0"
