    "axios": "1.21.1",
    "elliptic": "npm:@mapped/elliptic@^6.6.9",
    "underscore": "^1.13.8",
    "compression": "1.8.2",
    "shell-quote": "1.11.0",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
