    "chai": "^4.2.0",
    "dotenv": "^16.3.1",
    "eslint": "^9.39.1",
    "eslint-config-expo": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "hardhat": "^2.29.0",
    "hardhat-gas-reporter": "^2.3.0",
    "prettier": "^3.6.2",
    "solidity-coverage": "^0.8.17",
    "ts-node": ">=8.0.0",
