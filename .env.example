# =============================================================================
# Desarrollo local = Arbitrum Sepolia (421614).
# Arbitrum One (42161) solo con CONFIRM_MAINNET=yes y CONFIRM_FOUNDER_WALLET=yes.
# Marcadores vacíos. No ponga claves, RPC con clave ni direcciones reales.
# La app no usa servidor propio. Los avisos son locales en el teléfono.
# =============================================================================

# WalletConnect / Reown — obligatorio (https://dashboard.reown.com)
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- App local (Arbitrum Sepolia, 421614) ---
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_CHAIN_ID=421614
EXPO_PUBLIC_CHAIN_NAME=arbitrumSepolia
EXPO_PUBLIC_ARBITRUM_RPC_URL_PRIMARY=
EXPO_PUBLIC_ARBITRUM_RPC_URL_FALLBACK_1=
EXPO_PUBLIC_ARBITRUM_RPC_URL_FALLBACK_2=
EXPO_PUBLIC_CONTRACT_ADDRESS_TESTNET=
EXPO_PUBLIC_LUSD_ADDRESS=
EXPO_PUBLIC_RESERVA_ADDRESS_TESTNET=
EXPO_PUBLIC_RESERVA_ADDRESS_MAINNET=
EXPO_PUBLIC_FAMA_ADDRESS_TESTNET=
EXPO_PUBLIC_FAMA_ADDRESS_MAINNET=
EXPO_PUBLIC_ALTA_ADDRESS_TESTNET=
EXPO_PUBLIC_ALTA_ADDRESS_MAINNET=

# --- Arbitrum One (42161). Lo rellena el deploy cuando Jose lo autorice. ---
EXPO_PUBLIC_CONTRACT_ADDRESS_MAINNET=
EXPO_PUBLIC_CONTRACT_START_BLOCK=

# Hardhat. Nunca ponga esta clave en EXPO_PUBLIC_* ni la suba a git.
# PRIVATE_KEY = deployer. ATTESTER_PRIVATE_KEY = otra clave.
PRIVATE_KEY=
ATTESTER_PRIVATE_KEY=
ARBITRUM_SEPOLIA_RPC_URL=
ARBITRUM_ONE_RPC_URL=

# Despliegue: npm run deploy:arbitrum:sepolia o, en One, CONFIRM_MAINNET=yes npm run deploy:arbitrum
CONFIRM_MAINNET=
CONFIRM_FOUNDER_WALLET=
# Billetera del fundador. Vacía hasta el deploy que Jose autorice.
FOUNDER_ADDRESS=
# Feed del secuenciador de Arbitrum (caída de la red). Vacío: no hay dirección real aquí.
SEQUENCER_FEED=
# Segundo admin del quórum 2 de 3. Vacío.
ADMIN_2=
# Tercer admin del quórum 2 de 3. Vacío.
ADMIN_3=
ADMINS=
REQUIRED_CONFIRMATIONS=
FEE_COLLECTOR=
EXPO_PUBLIC_FEE_COLLECTOR=
LUSD_ADDRESS=
LUSD_FEED=

# Enlace HTTPS de invitación (página /invite).
EXPO_PUBLIC_INVITE_WEB_BASE=

# MobSF. La clave está en la UI. No la suba a git.
MOBSF_API_KEY=

# SonarCloud. El enlace del panel lo cambia el dueño. Token nunca en git.
# SONAR_TOKEN=
# SNYK_TOKEN=
