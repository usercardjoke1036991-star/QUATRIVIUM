# =============================================================================
# Desarrollo local = Arbitrum Sepolia. Arbitrum One solo con CONFIRM_MAINNET=yes.
# La app no usa servidor propio. Los avisos son locales en el teléfono.
# =============================================================================

# WalletConnect / Reown — obligatorio (https://dashboard.reown.com)
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# --- App local (testnet) ---
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_CHAIN_ID=97
EXPO_PUBLIC_CHAIN_NAME=bscTestnet
EXPO_PUBLIC_BSC_RPC_URL_PRIMARY=https://bsc-testnet-rpc.publicnode.com
EXPO_PUBLIC_BSC_RPC_URL_FALLBACK_1=https://bsc-testnet.drpc.org
EXPO_PUBLIC_BSC_RPC_URL_FALLBACK_2=https://bsc-testnet.bnbchain.org
EXPO_PUBLIC_CONTRACT_ADDRESS_TESTNET=0xD2d2A9eF0D1e4f253abc90Dd4ACb0E6C50B2de9f
EXPO_PUBLIC_USDT_ADDRESS=0x2d4AE5E6984D98777a24473F196326ff2604F5A6
# Reserva (hermano del crédito). Vacío: Demo usa práctica local.
# Tras el deploy, el script escribe la misma dirección aquí y en constants/deployedAddresses.ts.
# La app solo acepta esa dirección oficial (igual que Credit).
EXPO_PUBLIC_RESERVA_ADDRESS_TESTNET=
EXPO_PUBLIC_RESERVA_ADDRESS_MAINNET=
# FamaCaja (hermano del crédito: canje de fama). Vacío = contrato legado sin canje (Demo 0xD2d2).
# Tras el deploy, el script escribe EXPO_PUBLIC_FAMA_ADDRESS_* y credit.famaHermano() es la fuente de verdad.
EXPO_PUBLIC_FAMA_ADDRESS_TESTNET=
EXPO_PUBLIC_FAMA_ADDRESS_MAINNET=

# --- Mainnet (lo rellena el deploy o usted tras desplegar). La app local NO usa esto. ---
EXPO_PUBLIC_CONTRACT_ADDRESS_MAINNET=0x0000000000000000000000000000000000000000
# Bloque de creación del contrato testnet (también en constants/deployedAddresses.ts).
EXPO_PUBLIC_CONTRACT_START_BLOCK=130652258

# Hardhat — NUNCA ponga esta clave en EXPO_PUBLIC_* ni la suba a git.
# PRIVATE_KEY = deployer / owner. ATTESTER_PRIVATE_KEY = quien firma OTP. En mainnet DEBE ser otra clave.
PRIVATE_KEY=your_private_key_here
ATTESTER_PRIVATE_KEY=
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
BSC_MAINNET_RPC_URL=https://arb1.arbitrum.io/rpc

# Despliegue mainnet: tesorería explícita, USDT y feed reales.
# ADMINS: la primera dirección es la fundadora (raíz + admin). Las otras dos
# se pueden poner aquí o agregar después desde la app con su permiso (72 h).
# CONFIRM_MAINNET=yes
# npm run deploy:bsc
CONFIRM_MAINNET=
ADMINS=
REQUIRED_CONFIRMATIONS=1
FEE_COLLECTOR=
EXPO_PUBLIC_FEE_COLLECTOR=

# Mainnet (el script de deploy los usa si chain 56; no los ponga en el .env de testnet activo)
# USDT_ADDRESS=0x55d398326f99059ff775485246999027b3197955
# USDT_FEED=0xB97Ad0E75fa537bf4D14E83Bc6B2fAAb978903a6
# USDT Demo live (no usar el USDT canónico de testnet 0x3376…).
USDT_ADDRESS=0x2d4AE5E6984D98777a24473F196326ff2604F5A6
USDT_FEED=0xeca2605f0bcf2ba5966372c99837b1f182d3d620

# Enlace HTTPS de invitación (página /invite).
EXPO_PUBLIC_INVITE_WEB_BASE=https://quatriviumcredit.app

# Centinela de cuentas (scripts/sentinel.py). Solo lectura. Sin PRIVATE_KEY.
# SENTINEL_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# SENTINEL_CREDIT=
# SENTINEL_RESERVA=
# SENTINEL_TOKEN=
# SENTINEL_POLL_SEC=12
# Attester 2-de-2 (off-chain). La cadena sigue viendo una sola firma.
# ATTESTER_2OF2=1
# ATTESTER_COSIGN_KEY=
# EXPO_PUBLIC_ALTA_ADDRESS_TESTNET=
# EXPO_PUBLIC_ALTA_ADDRESS_MAINNET=
# SAFE_ADMIN=

# MobSF (http://localhost:8000). La clave está en API Key de la UI. No la suba a git.
MOBSF_API_KEY=
# MOBSF_URL=http://localhost:8000
# MOBSF_APK=./android/app/build/outputs/apk/debug/app-debug.apk

# SonarCloud (https://sonarcloud.io). Token de cuenta, nunca en git.
# Local opcional: SONAR_HOST_URL=http://127.0.0.1:9000
# SONAR_HOST_URL=https://sonarcloud.io
# SONAR_TOKEN=
# SNYK_TOKEN=
